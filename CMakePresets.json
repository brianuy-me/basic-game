{
	"version": 6,
	"cmakeMinimumRequired": { "major": 4, "minor": 2, "patch": 0 },
	"configurePresets": [
		{
			"name": "windows-base",
			"hidden": true,	
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}",
			"cacheVariables": { 
				"CMAKE_CONFIGURATION_TYPES":"Debug;Release"
			}
		},
		{
			"name": "ninja-x64",
			"displayName": "Ninja Multi-Config (x64)",
			"inherits": "windows-base",
			"generator": "Ninja Multi-Config",
			"architecture": { "value": "x64", "strategy": "external" },
			"cacheVariables": { 
			"CMAKE_EXPORT_COMPILE_COMMANDS": "ON", 
			"CMAKE_DEFAULT_BUILD_TYPE": "Debug" 
			}
		},
		{
			"name": "vs2026-x64",
			"displayName": "Visual Studio 2026 (x64)",
			"inherits": "windows-base",
			"generator": "Visual Studio 18 2026",
			"architecture": { "value": "x64", "strategy": "set" }
		}
	],
	"buildPresets": [
		{
			"name": "vs2026-x64-debug",
			"configurePreset": "vs2026-x64",
			"configuration": "Debug"
		},
		{
			"name": "vs2026-x64-release",
			"configurePreset": "vs2026-x64",
			"configuration": "Release"
		},
		{
			"name": "ninja-x64-debug",
			"configurePreset": "ninja-x64",
			"configuration": "Debug"
		},
		{
			"name": "ninja-x64-release",
			"configurePreset": "ninja-x64",
			"configuration": "Release"
		}
	]
}